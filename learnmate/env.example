# ============================================================
#   LearnMate – Agentic AI for Personalized Course Pathways
#   Environment Configuration
# ============================================================

# ----------------------------
# IBM watsonx.ai / Granite AI
# ----------------------------
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_ibm_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_REGION=us-south

# IBM Granite Model IDs (IBM Cloud Lite supported)
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
IBM_GRANITE_CHAT_MODEL=ibm/granite-13b-chat-v2
IBM_GRANITE_EMBED_MODEL=ibm/slate-125m-english-rtrvr

# ----------------------------
# IBM Cloud Credentials
# ----------------------------
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_CLOUD_REGION=us-south
IBM_CLOUD_RESOURCE_GROUP=Default

# ----------------------------
# IBM Cloudant (NoSQL DB)
# ----------------------------
CLOUDANT_URL=https://your-cloudant-instance.cloudantnosqldb.appdomain.cloud
CLOUDANT_API_KEY=your_cloudant_api_key_here
CLOUDANT_DB_NAME=learnmate_db

# ----------------------------
# IBM Watson NLU (optional)
# ----------------------------
WATSON_NLU_API_KEY=your_watson_nlu_api_key_here
WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com

# ----------------------------
# Application Settings
# ----------------------------
APP_NAME=LearnMate
APP_PORT=5000
APP_ENV=development
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------
# Frontend Settings
# ----------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=LearnMate
VITE_APP_VERSION=1.0.0

# ----------------------------
# Rate Limiting & Caching
# ----------------------------
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=3600

# ----------------------------
# Logging
# ----------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
